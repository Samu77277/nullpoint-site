# Telegram-бот для заявок: токен от @BotFather, chat_id группы/чата (узнать: @getmyid_bot или getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yandex SmartCaptcha (console.yandex.cloud → SmartCaptcha). Пусто — капча отключена.
PUBLIC_SMARTCAPTCHA_SITEKEY=
SMARTCAPTCHA_SERVER_KEY=

# Яндекс Метрика: номер счётчика. Пусто — метрика отключена.
PUBLIC_YM_ID=

# Путь к SQLite с заявками (рядом создаётся папка uploads/)
DB_PATH=./data/leads.db
