---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaseCover from '../../components/CaseCover.astro';
import { company } from '../../data/site';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, index: i, next: cases[(i + 1) % cases.length], nextIndex: (i + 1) % cases.length },
  }));
}

const { entry, index, next, nextIndex } = Astro.props;
const { Content } = await render(entry);
const c = entry.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: c.title,
  description: c.description,
  dateCreated: String(c.year),
  creator: { '@type': 'Organization', name: company.name },
  keywords: c.stack.join(', '),
};

const meta = [
  { label: 'Клиент', value: c.client },
  { label: 'Сроки', value: c.duration },
  { label: 'Команда', value: c.team },
  { label: 'Год', value: String(c.year) },
];
---

<Layout title={c.title} description={c.description} jsonLd={jsonLd}>
  <article>
    <header class="relative overflow-hidden pt-32 md:pt-40">
      <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_50%_at_50%_0%,black,transparent)]" aria-hidden="true"></div>

      <div class="container-page relative">
        <a href="/#cases" class="nav-link inline-flex items-center gap-2 font-mono !text-xs uppercase tracking-wider">
          <span aria-hidden="true">←</span> Все кейсы
        </a>
        <p class="eyebrow mt-10" data-reveal>{c.industry}</p>
        <h1 class="mt-4 max-w-5xl font-display text-[clamp(2rem,1.2rem+3.6vw,4.25rem)] leading-[1.05] font-semibold tracking-[-0.03em] text-balance" data-reveal style="--i: 1">
          {c.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl" data-reveal style="--i: 2">{c.description}</p>

        <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-line pt-8 md:grid-cols-4" data-reveal style="--i: 3">
          {meta.map((m) => (
            <div>
              <dt class="font-mono text-xs tracking-wider text-muted uppercase">{m.label}</dt>
              <dd class="mt-2 font-medium">{m.value}</dd>
            </div>
          ))}
        </dl>

        <CaseCover index={index} variant={c.cover} label={c.stack.join(' · ')} class="mt-12 aspect-[16/10] rounded-3xl border border-line md:aspect-[21/9]" />
      </div>
    </header>

    <section class="section">
      <div class="container-page">
        <p class="eyebrow">Результаты</p>
        <dl class="mt-8 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-3">
          {c.results.map((r, i) => (
            <div class="flex flex-col bg-bg p-8 md:p-10" data-reveal style={`--i: ${i}`}>
              <dt class="order-2 mt-2 text-muted">{r.label}</dt>
              <dd class="font-display text-4xl font-semibold tracking-tight text-accent md:text-5xl">{r.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="container-page grid gap-12 pb-24 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow">Стек</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {c.stack.map((s) => <li class="rounded-full border border-line-strong px-3 py-1 font-mono text-xs text-muted">{s}</li>)}
          </ul>
        </div>
      </aside>

      <div class="lg:col-span-8">
        <div class="case-content">
          <Content />
        </div>

        {c.testimonial && (
          <figure class="card mt-16 p-8 md:p-10">
            <span class="font-display text-5xl leading-none text-accent" aria-hidden="true">“</span>
            <blockquote class="mt-2 text-lg leading-relaxed md:text-xl">{c.testimonial.text}</blockquote>
            <figcaption class="mt-6 text-sm text-muted">
              <span class="font-medium text-fg">{c.testimonial.author}</span>, {c.testimonial.role}
            </figcaption>
          </figure>
        )}
      </div>
    </div>
  </article>

  <section class="container-page pb-24">
    <div class="relative overflow-hidden rounded-[2rem] border border-line bg-surface p-8 md:p-16">
      <div class="pointer-events-none absolute -top-40 -right-20 size-[420px] rounded-full bg-accent/15 blur-[100px]" aria-hidden="true"></div>
      <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <div>
          <h2 class="section-title">Хотите так же?</h2>
          <p class="mt-3 text-lg text-muted">Расскажите о задаче — предложим решение и оценку.</p>
        </div>
        <a href="/#contact" data-goal="cta_click" class="btn-primary shrink-0">Обсудить проект <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {next.id !== entry.id && (
    <nav class="border-t border-line" aria-label="Следующий кейс">
      <a href={`/cases/${next.id}`} class="group container-page grid items-center gap-8 py-16 md:grid-cols-2 md:py-24">
        <div>
          <p class="eyebrow !text-muted">Следующий кейс</p>
          <p class="mt-4 font-display text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent md:text-4xl">
            {next.data.title} <span aria-hidden="true">→</span>
          </p>
        </div>
        <CaseCover index={nextIndex} variant={next.data.cover} label={next.data.industry} class="aspect-[16/9] rounded-2xl border border-line" />
      </a>
    </nav>
  )}
</Layout>

<style>
  .case-content :global(h2) {
    margin-top: 3rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .case-content :global(h2:first-child) {
    margin-top: 0;
  }
  .case-content :global(p) {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .case-content :global(ul) {
    margin-top: 1rem;
    list-style: disc;
    padding-left: 1.5rem;
    color: var(--color-muted);
  }
  .case-content :global(img) {
    margin-top: 2rem;
    border-radius: 1.25rem;
    border: 1px solid var(--color-line);
  }
</style>
