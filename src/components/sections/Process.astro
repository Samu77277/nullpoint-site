---
import { process } from '../../data/site';
---

<section id="process" class="section border-t border-line">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28" data-reveal>
        <p class="eyebrow">03 / Процесс</p>
        <h2 class="section-title mt-4">Как мы работаем</h2>
        <p class="mt-6 max-w-sm text-muted">
          Сначала доказываем эффект на ваших данных, потом масштабируем. Демо каждые две недели, метрики качества агента — с первого прототипа.
        </p>
      </div>
    </div>

    <ol class="lg:col-span-8">
      {process.map((step, i) => (
        <li class="group grid grid-cols-[3rem_1fr] gap-x-4 border-t border-line py-8 last:border-b md:grid-cols-[4rem_1fr_auto] md:gap-x-8" data-reveal>
          <span class="font-mono text-sm text-muted transition-colors group-hover:text-accent">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="font-display text-xl font-medium tracking-tight md:text-2xl">{step.title}</h3>
            <p class="mt-2 text-muted">{step.text}</p>
          </div>
          <span class="col-start-2 mt-4 self-start justify-self-start rounded-full border border-line-strong px-3 py-1 font-mono text-xs text-muted md:col-start-3 md:mt-1">
            {step.duration}
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
